# Backend API base URL baked into production builds (must end in /api).
#   Local backend stack:  http://localhost:5000/api
#   Production:           https://api.rwandaavocados.rw/api
VITE_API_BASE_URL=http://localhost:5000/api

# Where `npm run dev` proxies /api requests (no /api suffix).
VITE_PROXY_TARGET=http://localhost:5000

# API URL baked into the image built by `docker compose up` (must end in /api).
WEB_API_BASE_URL=http://localhost:5000/api

# Host port for `docker compose up` (nginx serves the SPA here).
WEB_HOST_PORT=3000
